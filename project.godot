; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Visual Inventory"
run/main_scene="res://addons/visual_res_editor_panel/visual_inventory_dome.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/integer_division=0

[editor_plugins]

enabled=PackedStringArray("res://addons/visual_res_editor_panel/plugin.cfg")

